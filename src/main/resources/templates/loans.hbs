{{#> layout pageTitle="Loans" isLoans=true}}
<h2>🔄 Loans</h2>

<div class="toolbar">
    <input type="text" id="filterBorrower" placeholder="Borrower name" hidden>
    <label class="checkbox-label"><input type="checkbox" id="filterActive"> Active only</label>
    <button type="button" onclick="applyFilters()">Search</button>
    <button type="button" class="btn-primary" onclick="openCreateModal()">+ New Loan</button>
</div>

<table class="data-table">
    <thead>
        <tr>
            <th>Book</th>
            <th>Borrower</th>
            <th>Borrowed At</th>
            <th>Due Date</th>
            <th>Status</th>
            <th id="actionsHeader" hidden>Actions</th>
        </tr>
    </thead>
    <tbody id="loansBody">
        <tr><td colspan="6" class="empty">Loading…</td></tr>
    </tbody>
</table>

<div class="pagination">
    <button type="button" id="prevPageBtn" onclick="changePage(-1)">« Prev</button>
    <span id="pageIndicator">Page 1</span>
    <button type="button" id="nextPageBtn" onclick="changePage(1)">Next »</button>
</div>

<div id="loanModal" class="modal hidden">
    <div class="modal-content">
        <h3>New Loan</h3>
        <form id="loanForm">
            <label for="bookId">Book</label>
            <select id="bookId" required></select>

            <div id="borrowerGroup" hidden>
                <label for="borrowerId">Borrower</label>
                <select id="borrowerId"></select>
            </div>

            <label for="daysToReturn">Days to Return</label>
            <input type="number" id="daysToReturn" value="14" required>

            <div id="loanFormError" class="form-error"></div>

            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="btn-primary">Borrow</button>
            </div>
        </form>
    </div>
</div>

<script src="/static/js/loans.js"></script>
{{/layout}}


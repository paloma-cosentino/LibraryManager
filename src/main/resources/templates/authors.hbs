{{#> layout pageTitle="Authors" isAuthors=true}}
<h2>✍️ Authors</h2>

<div class="toolbar">
    <input type="text" id="filterName" placeholder="Name">
    <button type="button" onclick="applyFilters()">Search</button>
    <button type="button" class="btn-primary" onclick="openCreateModal()">+ Add Author</button>
</div>

<table class="data-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="authorsBody">
        <tr><td colspan="2" class="empty">Loading…</td></tr>
    </tbody>
</table>

<div class="pagination">
    <button type="button" id="prevPageBtn" onclick="changePage(-1)">« Prev</button>
    <span id="pageIndicator">Page 1</span>
    <button type="button" id="nextPageBtn" onclick="changePage(1)">Next »</button>
</div>

<div id="authorModal" class="modal hidden">
    <div class="modal-content">
        <h3 id="modalTitle">Add Author</h3>
        <form id="authorForm">
            <input type="hidden" id="authorId">

            <label for="name">Name</label>
            <input type="text" id="name" required>

            <div id="authorFormError" class="form-error"></div>

            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<script src="/static/js/authors.js"></script>
{{/layout}}

